   "source": [
    "import pandas as pd\n",
    "\n",
    "# Sample marks data\n",
    "marks = [45, 50, 55, 60, 60, 65, 70, 75, 80, 90]\n",
    "\n",
    "# Convert the list to a Pandas Series\n",
    "s = pd.Series(marks)\n",
    "\n",
    "# Calculate and print Skewness and Kurtosis\n",
    "print(\"Skewness:\", round(s.skew(), 4))\n",
    "print(\"Kurtosis:\", round(s.kurt(), 4))"
   ]
