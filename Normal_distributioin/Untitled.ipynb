    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "data = np.random.normal(loc=70, scale=10, size=1000)\n",
    "plt.hist(data, bins=30, edgecolor=\"black\")\n",
    "plt.xlabel(\"Value\")\n",
    "plt.ylabel(\"Frequency\")\n",
    "plt.title(\"Normal Distribution\")\n",
    "plt.show()"
   ]
